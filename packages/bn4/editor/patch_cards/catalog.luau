export type Shot = "zap_ring" | "water_gun" | "flower" | "reflect" | "guts_machine_gun"
    | "cannon" | "mini_bomb" | "heat_shot" | "bubbler" | "thunder1"
    | "sword" | "spreader" | "random_trap_chip" | "cracked_panel" | "poison_panel"
    | "crackout" | "copy_damage" | "wide_shot1" | "thunder2" | "double_crack"
    | "wide_sword" | "recov10" | "lance" | "hole" | "wide_shot2"
    | "sand_ring" | "energy_bomb" | "thunder3" | "triple_crack" | "long_sword"
    | "full_custom" | "wide_shot3" | "wind_rack" | "mega_energy_bomb" | "ball"
    | "bug_bomb" | "wide_blade" | "long_blade" | "north_wind" | "panel_return"
    | "blind" | "blizzard" | "heat_breath" | "woody_powder" | "repair"
    | "air_shot" | "elec_shock" | "guard1" | "grass_panel" | "ice_panel"
export type Panel = "broken" | "cracked" | "metal" | "holy"
export type Aura = "barrier100" | "barrier200" | "life_aura"
export type Soul = "roll" | "guts" | "wind" | "search" | "fire" | "thunder" | "proto" | "number" | "metal" | "junk" | "aqua" | "wood"
export type Color = "red" | "yellow" | "white" | "green"
export type PetColor = "blue" | "pink" | "green" | "black"
export type Effect = {read kind: "max_hp" | "buster_attack" | "custom_slots" | "mega_folder" | "giga_folder", value: number}
    | {read kind: "b_button" | "b_charge" | "b_left", shot: Shot}
    | {read kind: "panel_step", panel: Panel} | {read kind: "aura", aura: Aura} | {read kind: "soul", soul: Soul}
    | {read kind: "color", color: Color} | {read kind: "pet_menu", color: PetColor}
    | {read kind: "none" | "triple_supporter" | "full_synchro" | "all_guard"}
export type Bug = {read kind: "hp", value: number}
    | {read kind: "confused" | "auto_move" | "custom_hp" | "custom_minus1" | "poison_panel_step"}
export type Card = {name: string, slot: number, effect: Effect, bugs: {Bug}}
type Definition = {names: {[string]: string}, slot: number, effect: Effect, bugs: {Bug}}
local function max_hp(value: number): Effect return {kind = "max_hp", value = value} end
local function aura(aura: Aura): Effect return {kind = "aura", aura = aura} end
local function b_button(shot: Shot): Effect return {kind = "b_button", shot = shot} end
local function panel_step(panel: Panel): Effect return {kind = "panel_step", panel = panel} end
local function custom_slots(value: number): Effect return {kind = "custom_slots", value = value} end
local function mega_folder(value: number): Effect return {kind = "mega_folder", value = value} end
local function buster_attack(value: number): Effect return {kind = "buster_attack", value = value} end
local function b_charge(shot: Shot): Effect return {kind = "b_charge", shot = shot} end
local function pet_menu(color: PetColor): {kind: "pet_menu", color: PetColor} return {kind = "pet_menu", color = color} end
local function b_left(shot: Shot): Effect return {kind = "b_left", shot = shot} end
local function full_synchro(): Effect return {kind = "full_synchro"} end
local function giga_folder(value: number): Effect return {kind = "giga_folder", value = value} end
local function color(color: Color): {kind: "color", color: Color} return {kind = "color", color = color} end
local function triple_supporter(): Effect return {kind = "triple_supporter"} end
local function all_guard(): Effect return {kind = "all_guard"} end
local function soul(soul: Soul): Effect return {kind = "soul", soul = soul} end
