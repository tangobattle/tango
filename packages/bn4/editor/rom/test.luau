--!strict
local rom = require("./init")
local offsets = require("./offsets")
local gba = require("@gba")
local message = require("./message")
local charset = require("./charset")

return function()
    local bytes, wram = buffer.create(0x120000), buffer.create(0x73d2)
    for code, expected in offsets.definitions do
        buffer.writestring(bytes, 0xac, code)
        buffer.writeu8(bytes, 0xbc, expected.revision)
        assert(rom.definition(bytes) == expected)
    end
    buffer.writestring(bytes, 0xac, "B4WE")
    buffer.writeu8(bytes, 0xbc, 0)
    buffer.writeu32(bytes, 0x15a78, 0x08081000)
    buffer.writeu32(bytes, 0x4fb74, 0x08080000)
    buffer.writeu32(bytes, 0x1fde0, 0x08080100)
    buffer.writeu32(bytes, 0x4fb84, 0x08080200)
    buffer.writeu32(bytes, 0x3e63c, 0x08080300)
    for _, address in {0x80000, 0x80100, 0x80200, 0x80300} do
        buffer.writeu16(bytes, address, 4)
        buffer.writeu16(bytes, address + 2, 5)
        buffer.writeu8(bytes, address + 4, 0xe5)
    end
    buffer.writestring(bytes, 0x80005, "\x0b\xe8\xe6\x0b\xe7\x01\xed\x00\x0b\x0b\xf0\x00\x0b\xfc\x06\xff\x00\x00\xe5")
    buffer.writestring(bytes, 0x80105, "\xff\x01\x00\xe5")
    buffer.writestring(bytes, 0x80205, "\x0c\xe5")
    buffer.writestring(bytes, 0x80305, "\x0d\xe5")
    buffer.writestring(wram, 0x522, "\x0c\xe5")
    buffer.writestring(wram, 0x1772, "\x0d\xe5")
    local chip = 0x197ec + 0x2c
    buffer.writestring(bytes, chip, "\x01\x1a\xff\xff")
    buffer.writeu8(bytes, chip + 6, 40)
    buffer.writeu8(bytes, chip + 7, 3)
    buffer.writeu8(bytes, chip + 8, 1)
    buffer.writeu8(bytes, chip + 9, 0x20)
    buffer.writeu16(bytes, chip + 0x1a, 1000)
    buffer.writeu16(bytes, chip + 0x1c, 11)
    buffer.writeu32(bytes, chip + 0x20, 0x08081400)
    buffer.writeu32(bytes, chip + 0x24, 0x08081500)
    buffer.writeu32(bytes, chip + 0x28, 0x08081000)
    buffer.writeu16(bytes, 0x81002, 31)
    buffer.writeu8(bytes, 0x81400, 1)
    buffer.writeu8(bytes, 0x81500, 0x11)
    local part = 0x4563c + 4 * 16
    buffer.writeu8(bytes, part + 3, 2)
    buffer.writeu8(bytes, part + 4, 3)
    buffer.writeu32(bytes, part + 8, 0x08081200)
    buffer.writeu32(bytes, part + 12, 0x08081300)
    buffer.writeu8(bytes, 0x81200 + 12, 1)
    local assets = rom.open(bytes, wram, nil)
    local c = assets.chip(1)
    assert(c and c.name == "A\nC" and c.description == "B")
    assert(c.codes[1] == 1 and c.codes[2] == 26 and #c.codes == 2)
    assert(c.element == 3 and c.class == "mega" and c.mb == 40 and c.attack == 0 and c.order == 11)
    assert(c.dark and c.legal and assets.chip(350) == nil and assets.chip(-1) == nil)
    assert(buffer.readu32(c.icon().rgba, 0) == 0xff0000ff and buffer.readu32(c.icon().rgba, 4) == 0)
    assert(buffer.readu32(c.image().rgba, 4) == 0xff0000ff)
    local p = assets.navicust_part(4)
    assert(p and p.name == "B" and p.description == "C" and p.color == "pink" and p.color_id == 2)
    assert(p.solid and p.effect_group == 3 and p.effects[1].kind == "super_armor" and p.bugs[1] == "custom_hp")
    local shape = p.bitmap(false)
    assert(shape and #shape == 25 and shape[13] and p.bitmap(true) == nil)
    shape[13] = false
    assert((p.bitmap(false) :: {boolean})[13])
    assert(assets.navicust_part(188) == nil)
    local card = assets.patch_card(7)
    assert(card and card.name == "Max HP Up" and card.slot == 3)

    local encoded = buffer.fromstring("\xe4\x00\xe5")
    local region = gba.mapper(encoded, nil).region(0x08000000)
    assert(region and message.parse(region, 0, 3, charset.JA, nil) == charset.JA[0xe4 + 1])
    for _, invalid in {"\xff\x00", "\xed\x00\x01", "\xe6"} do
        local input = buffer.fromstring(invalid)
        local truncated = gba.mapper(input, nil).region(0x08000000)
        assert(truncated and message.parse(truncated, 0, #invalid, charset.EN, nil) == nil)
    end
end
