--!strict
local values = {
    red = {{0xde, 0x10, 0x00}, {0xbd, 0x00, 0x00}},
    pink = {{0xde, 0x8c, 0xc6}, {0xbd, 0x6b, 0xa5}},
    yellow = {{0xde, 0xde, 0x00}, {0xbd, 0xbd, 0x00}},
    green = {{0x18, 0xc6, 0x00}, {0x00, 0xa5, 0x00}},
    blue = {{0x29, 0x84, 0xde}, {0x08, 0x60, 0xb8}},
    white = {{0xde, 0xde, 0xde}, {0xbd, 0xbd, 0xbd}},
    orange = {{0xde, 0x7b, 0x00}, {0xbd, 0x5a, 0x00}},
    purple = {{0x94, 0x00, 0xce}, {0x73, 0x00, 0xad}},
    gray = {{0x84, 0x84, 0x84}, {0x63, 0x63, 0x63}},
} :: {[string]: {{number}}}

local function raw(name: string, plus: boolean): {number}
    return (values[name] or values.gray)[if plus then 2 else 1]
end
local function color(name: string, plus: boolean, alpha: number?): {number}
    local rgb = raw(name, plus)
    return {rgb[1] / 255, rgb[2] / 255, rgb[3] / 255, alpha or 1}
end
return {raw = raw, color = color}
